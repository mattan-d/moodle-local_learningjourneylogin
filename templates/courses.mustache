{{!
    Copyright © CentricApp LTD. dev@centricapp.co.il

    @template local_learningjourneylogin/courses

    Grid of courses that use the learningjourney format, with content-only chrome.
}}
<div class="ljcatalog">
    <div class="ljcatalog-introblock">
        <h1 class="ljcatalog-title">{{heading}}</h1>
        <p class="ljcatalog-intro">{{intro}}</p>
        <p class="ljcatalog-count">{{countlabel}}</p>
    </div>

    {{#hascourses}}
        <div class="format-learningjourney-mode-view">
            <ul class="format-learningjourney-sectionlist lj-layout-grid lj-grid-cols-3 learningjourney"
                data-for="course_sectionlist">
                {{#courses}}
                    <li class="section course-section main lj-card-view">
                        <a class="lj-card-link" href="{{url}}" aria-label="{{fullname}}"></a>
                        <div class="section-item">
                            <div class="course-section-header">
                                <h3 class="sectionname"><span>{{fullname}}</span></h3>
                            </div>
                            {{#category}}
                                <div class="lj-card-type">{{category}}</div>
                            {{/category}}
                            {{#hassummary}}
                                <p class="lj-card-summary">{{summary}}</p>
                            {{/hassummary}}
                            <div class="section-learningjourney-image">
                                {{#hasimage}}
                                    <img src="{{image}}" alt="">
                                {{/hasimage}}
                                {{#hidden}}
                                    <span class="lj-card-status lj-card-status--locked">{{hiddenlabel}}</span>
                                {{/hidden}}
                                {{^hidden}}
                                    {{#enrolled}}
                                        <span class="lj-card-status">{{enrolledlabel}}</span>
                                    {{/enrolled}}
                                {{/hidden}}
                            </div>
                        </div>
                    </li>
                {{/courses}}
            </ul>
        </div>
    {{/hascourses}}
    {{^hascourses}}
        <p class="ljcatalog-empty">{{nocourses}}</p>
    {{/hascourses}}
</div>
