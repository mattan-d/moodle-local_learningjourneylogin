{{!
    Copyright © CentricApp LTD. dev@centricapp.co.il

    @template local_learningjourneylogin/login

    Login card for the learning journey portal.
}}
<div class="ljlogin">
    <div class="ljlogin-card">
        {{#haslogo}}
            <img class="ljlogin-logo" src="{{logourl}}" alt="{{logoalt}}">
        {{/haslogo}}
        <h1 class="ljlogin-title">{{logintitle}}</h1>
        <p class="ljlogin-subtitle">{{loginsubtitle}}</p>

        {{#haserror}}
            <div class="ljlogin-alert" role="alert">{{error}}</div>
        {{/haserror}}

        {{#showloginform}}
        <form class="ljlogin-form" method="post" action="" autocomplete="on">
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <label class="ljlogin-label" for="lj-username">{{usernamelabel}}</label>
            <input class="ljlogin-input" id="lj-username" name="username" type="text" value="{{username}}"
                   autocomplete="username" autocapitalize="none" spellcheck="false" required>

            <label class="ljlogin-label" for="lj-password">{{passwordlabel}}</label>
            <input class="ljlogin-input" id="lj-password" name="password" type="password"
                   autocomplete="current-password" required>

            {{#hasrecaptcha}}
                <div class="ljlogin-captcha">{{{recaptcha}}}</div>
            {{/hasrecaptcha}}

            <button class="ljlogin-submit" type="submit">{{loginlabel}}</button>
        </form>

        <a class="ljlogin-forgot" href="{{forgotpasswordurl}}">{{forgotpasswordlabel}}</a>
        {{/showloginform}}

        {{#hasidentityproviders}}
            <div class="ljlogin-idps">
                <h2 class="ljlogin-idps-heading">{{idpsheading}}</h2>
                {{#identityproviders}}
                    <a class="ljlogin-idp" href="{{url}}">
                        {{#iconurl}}
                            <img src="{{iconurl}}" alt="" width="24" height="24">
                        {{/iconurl}}
                        <span>{{name}}</span>
                    </a>
                {{/identityproviders}}
            </div>
        {{/hasidentityproviders}}

        <p class="ljlogin-site">{{sitename}}</p>
    </div>
</div>
